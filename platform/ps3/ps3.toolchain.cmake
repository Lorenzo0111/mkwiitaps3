# CMake toolchain for the PS3's PPU: ps3toolchain's ppu-gcc and PSL1GHT,
# found through the PS3DEV and PSL1GHT environment variables.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR powerpc64)
if(NOT DEFINED ENV{PS3DEV})
  message(FATAL_ERROR "Set PS3DEV to the PS3 toolchain folder (ps3toolchain), e.g. /usr/local/ps3dev")
endif()
set(PS3DEV "$ENV{PS3DEV}")
# ppu-gcc's link specs read PSL1GHT from the environment too.
if(NOT DEFINED ENV{PSL1GHT})
  message(FATAL_ERROR "Set PSL1GHT to the PSL1GHT folder (usually the same as PS3DEV)")
endif()
set(PSL1GHT "$ENV{PSL1GHT}")
set(CMAKE_C_COMPILER "${PS3DEV}/ppu/bin/ppu-gcc")
set(CMAKE_CXX_COMPILER "${PS3DEV}/ppu/bin/ppu-g++")
set(CMAKE_AR "${PS3DEV}/ppu/bin/ppu-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${PS3DEV}/ppu/bin/ppu-ranlib" CACHE FILEPATH "")
set(CMAKE_STRIP "${PS3DEV}/ppu/bin/ppu-strip" CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH "${PS3DEV}/ppu" "${PSL1GHT}/ppu")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_EXECUTABLE_SUFFIX ".elf")
